DATABASE_URL="postgresql://connectedos:connectedos@localhost:5432/connectedos?schema=public"
NEXTAUTH_URL=""
NEXTAUTH_SECRET="replace-with-a-random-secret"
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
# Directory UUID, not the tenant domain. See docs/integrations/microsoft-365-sign-in.md.
AZURE_AD_TENANT_ID=""
# Keep false until the member claim and existing-user identity links are configured.
ENABLE_ENTRA_LOGIN="false"
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_NAME="ConnectedOS Administrator"
INITIAL_ADMIN_PASSWORD=""
SAGE_ENABLED=false
SAGE_ALLOW_INVOICE_CREATE=false
PROJECT_INVOICE_APPROVER_USER_ID=
SAGE_SALES_LEDGER_ACCOUNT_ID=
SAGE_STANDARD_TAX_RATE_ID=
SAGE_ZERO_TAX_RATE_ID=
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_REDIRECT_URI=https://portal.connectedhsp.com/api/v1/integrations/sage/callback
SAGE_BUSINESS_ID=
# Dedicated 32-byte key encoded as 64 hex characters. Never commit the real key.
SAGE_TOKEN_ENCRYPTION_KEY=
# Separate document app. Keep disabled until selected-folder grants and pilot checks pass.
SHAREPOINT_ENABLED=false
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=
# Comma-separated approved folder item IDs, never a tenant-wide permission substitute.
SHAREPOINT_ALLOWED_ROOT_IDS=
# Explicit ISO timestamp: only new uploads after this time are eligible for copying.
SHAREPOINT_DOCUMENTS_SINCE=
# Enable only after folder audience checks. Internal quote margin/BoM exports are excluded.
SHAREPOINT_CAPTURE_EXPORTS=false
PARTNER_INTAKE_ENABLED=false
# Exactly three active ConnectedOS user UUIDs: James, Tim and Stephen.
PARTNER_INTAKE_NOTIFY_USER_IDS=
# Absolute path to ClamAV clamscan; missing/unavailable scanner leaves files quarantined.
PARTNER_INTAKE_SCANNER_PATH=
# Background scan only, 30-300 seconds. Timeout never releases an unscanned file.
PARTNER_INTAKE_SCAN_TIMEOUT_SECONDS=120
